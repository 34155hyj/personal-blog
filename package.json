{
  "name": "digital-garden",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal Digital Garden - Astro static blog",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "build:release": "node scripts/build-release.mjs",
    "test": "node --test tests/site.test.mjs",
    "test:release": "node --test tests/publication.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.4.13",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.6",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "typescript": "^5.9.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/markdown-remark": "^7.0.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.6.0",
    "wrangler": "^4.0.0",
    "playwright": "^1.0.0",
    "cheerio": "^1.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
