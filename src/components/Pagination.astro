---
interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;

function pageHref(page: number): string {
  return page === 1 ? `${base}/` : `${base}/${page}/`;
}
---

{
  total > 1 && (
    <nav class="pagination" aria-label="分页">
      {current > 1 ? (
        <a href={pageHref(current - 1)}>← 上一页</a>
      ) : (
        <span class="muted" aria-disabled="true">← 上一页</span>
      )}
      <span class="current" aria-label={`第 ${current} 页，共 ${total} 页`}>
        {current} / {total}
      </span>
      {current < total ? (
        <a href={pageHref(current + 1)}>下一页 →</a>
      ) : (
        <span class="muted" aria-disabled="true">下一页 →</span>
      )}
    </nav>
  )
}
