<button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label="深色模式" aria-pressed="false" title="切换主题">
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const scheme = matchMedia('(prefers-color-scheme: dark)');
  let selected: string | null = null;
  try { selected = localStorage.getItem('dg-theme'); } catch {}

  function syncButton() {
    button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }

  scheme.addEventListener('change', (event) => {
    if (selected === 'dark' || selected === 'light') return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    syncButton();
  });

  button?.addEventListener('click', () => {
    selected = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = selected;
    syncButton();
    try { localStorage.setItem('dg-theme', selected); } catch {}
  });
  syncButton();
</script>
