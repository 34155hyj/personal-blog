---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { collectionLabel, getAllContent, getAllTags, getPublished, indexHref } from '../utils/content';
import { siteDescription, siteTitle } from '../utils/site.mjs';

const [content, projects] = await Promise.all([getAllContent(), getPublished('projects')]);
const tags = (await getAllTags()).slice(0, 10);
const recent = content.filter(({ collection }) => collection !== 'projects').slice(0, 6);
const featured = projects.filter(({ data }) => data.featured).slice(0, 3);
const sections = ['blog', 'notes', 'garden', 'projects'] as const;
---
<BaseLayout title={siteTitle} description={siteDescription} activeNav="home">
  <div class="container home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 class="hero-title" id="hero-title">在这里，<br />想法<em>慢慢生长。</em></h1>
        <p class="hero-lead">记录论文阅读，整理科研方法与计算机视觉笔记，也分享自己做过的工具和项目。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/notes/">读科研笔记 <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/search/">搜索内容 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <nav class="home-index" aria-labelledby="home-index-title">
        <h2 id="home-index-title">花园索引</h2>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`/${section}/`}>
                <span>{collectionLabel(section)}</span>
                <span class="index-count">{content.filter(({ collection }) => collection === section).length} <span aria-hidden="true">↗</span></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    {recent.length > 0 && (
      <section class="home-section" aria-labelledby="recent-heading">
        <header class="section-heading">
          <h2 id="recent-heading">最近更新</h2>
          <a class="text-link" href="/archive/">全部归档 <span aria-hidden="true">→</span></a>
        </header>
        <div class="card-grid">{recent.map((item) => <PostCard item={item} heading="h3" />)}</div>
      </section>
    )}

    {featured.length > 0 && (
      <section class="home-section" aria-labelledby="projects-heading">
        <header class="section-heading">
          <h2 id="projects-heading">精选项目</h2>
          <a class="text-link" href="/projects/">全部项目 <span aria-hidden="true">→</span></a>
        </header>
        <div class="card-grid">{featured.map((project) => <ProjectCard project={project} heading="h3" />)}</div>
      </section>
    )}

    {tags.length > 0 && (
      <section class="home-section home-topics" aria-labelledby="tags-heading">
        <header class="section-heading">
          <h2 id="tags-heading">按主题阅读</h2>
          <a class="text-link" href="/categories/">全部分类 <span aria-hidden="true">→</span></a>
        </header>
        <div class="tag-cloud">
          {tags.map(({ tag, count }) => <a href={indexHref('tags', tag)}>{tag} <span class="tag-count">{count}</span></a>)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
