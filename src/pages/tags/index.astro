---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, indexHref } from '../../utils/content';

const tags = await getAllTags();
---

<BaseLayout title="标签" description="按标签浏览全站内容。" activeNav="">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">标签</h1>
      <p class="page-description">横跨博客、笔记、项目和知识卡片的标签索引。</p>
    </header>

    {
      tags.length > 0 ? (
        <div class="tag-cloud">
          {tags.map(({ tag, count }) => (
            <a href={indexHref('tags', tag)}>
              #{tag} <span class="tag-count">{count}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="muted">还没有标签。</p>
      )
    }
  </div>
</BaseLayout>
